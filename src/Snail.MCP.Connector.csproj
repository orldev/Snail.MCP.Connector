<Project Sdk="Microsoft.NET.Sdk.Web">

  <Sdk Name="Snail.Sdk.Mcp" />

  <!--
    Framework-dependent and HTTP only (Snail.Sdk.Mcp): the server runs in its own container on the stand, inside the
    company's network where its databases are, and answers the workers of the platform at its port.
  -->
  <PropertyGroup>
    <SnailMcpNative>false</SnailMcpNative>
    <SnailMcpTransport>Http</SnailMcpTransport>
    <SnailMcpContainer>true</SnailMcpContainer>
    <!-- SQL Server's client refuses to open a connection without culture data: it maps the server's collations through ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Description>Company databases for agents: MongoDB, SQL Server, PostgreSQL; read-only, writes on approval.</Description>
    <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;mongodb;database</PackageTags>
    <RepositoryUrl>https://github.com/orldev/Snail.MCP.Connector</RepositoryUrl>
    <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Connector</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.MCP.Connector.Tests" />
    <InternalsVisibleTo Include="Snail.MCP.Connector.Benchmarks" />
  </ItemGroup>

</Project>
